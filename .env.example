# Copy this file to .env and fill it in. .env is gitignored.
# These are settings, not passwords. Bot tokens and Google keys go into n8n credentials, never here.

# Your Telegram user ID (the digest is sent here). Get it from @userinfobot on Telegram.
TELEGRAM_CHAT_ID=

# The long ID in your Google Sheet's URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=

# Local AI (defaults work if Ollama runs on this laptop)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
